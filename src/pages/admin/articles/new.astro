---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArticleEditor from "../../../components/admin/ArticleEditor";
---

<BaseLayout title="Admin - New Article" description="Create a new blog article.">
  <div class="container mx-auto px-4 py-12 max-w-6xl">
    <div class="mb-8 flex items-center gap-4">
      <a href="/admin/articles" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
        ← Back to Articles
      </a>
      <div class="h-4 w-px bg-border"></div>
      <span class="text-sm font-medium">New Article</span>
    </div>
    <ArticleEditor client:only="react" mode="new" />
  </div>
</BaseLayout>
