---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import Card from "../../components/ui/Card.astro";
import { site } from "../../data/site";
import { SUPPORTED_LOCALES, type Locale } from "../../i18n";

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const isID = lang === "id";
---

<BaseLayout title={isID ? "Kontak" : "Contact"} description={isID ? "Hubungi saya untuk kolaborasi freelance." : "Get in touch for freelance opportunities, MVP development, or technical consulting."}>
  <div class="py-24">
    <div class="container mx-auto px-4 max-w-6xl">
      <header class="mb-16 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">{isID ? "Mari Kerja Bareng" : "Let's Work Together"}</h1>
        <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
          {isID
            ? "Punya masalah MVP, dashboard, atau backend API? Saat ini saya tersedia untuk proyek baru dan kolaborasi freelance."
            : "Have an MVP, dashboard, or backend problem to solve? I'm currently available for new projects and freelance opportunities."}
        </p>
      </header>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-5xl mx-auto">
        <div class="space-y-8">
          <div>
            <h2 class="text-2xl font-bold mb-6">{isID ? "Informasi Kontak" : "Contact Info"}</h2>
            <p class="text-muted-foreground mb-8">
              {isID
                ? "Cara tercepat menghubungi saya adalah email atau LinkedIn. Biasanya saya merespons dalam 24 jam."
                : "The best way to reach me is via email or LinkedIn. I typically respond within 24 hours."}
            </p>
          </div>

          <div class="space-y-6">
            <Card class="p-6 flex items-center space-x-4 hover:border-blue-500/30 transition-colors">
              <div class="w-12 h-12 rounded-full bg-primary/15 text-primary flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">Email</h3>
                <a href={`mailto:${site.email}`} class="text-lg font-medium hover:text-primary transition-colors">{site.email}</a>
              </div>
            </Card>
            <Card class="p-6 flex items-center space-x-4 hover:border-blue-500/30 transition-colors">
              <div class="w-12 h-12 rounded-full bg-primary/15 text-primary flex items-center justify-center">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a2 2 0 011.9 1.37l1.07 3.21a2 2 0 01-.45 2.06l-1.29 1.29a16 16 0 006.33 6.33l1.29-1.29a2 2 0 012.06-.45l3.21 1.07A2 2 0 0121 15.72V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
              </div>
              <div>
                <h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">Phone</h3>
                <a href="tel:+6282168797626" class="text-lg font-medium hover:text-primary transition-colors">{site.phone}</a>
              </div>
            </Card>
            <Card class="p-6 flex items-center space-x-4 hover:border-blue-500/30 transition-colors"><div class="w-12 h-12 rounded-full bg-primary/15 text-primary flex items-center justify-center"><svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.761 0 5-2.239 5-5v-14c0-2.761-2.239-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg></div><div><h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">LinkedIn</h3><a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="text-lg font-medium hover:text-primary transition-colors">Yosepri Berutu</a></div></Card>
            <Card class="p-6 flex items-center space-x-4 hover:border-blue-500/30 transition-colors"><div class="w-12 h-12 rounded-full bg-primary/15 text-primary flex items-center justify-center"><svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg></div><div><h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">GitHub</h3><a href={site.github} target="_blank" rel="noopener noreferrer" class="text-lg font-medium hover:text-primary transition-colors">yayanberutu</a></div></Card>
            <Card class="p-6 flex items-center space-x-4 hover:border-blue-500/30 transition-colors"><div class="w-12 h-12 rounded-full bg-primary/15 text-primary flex items-center justify-center"><svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.835 4.697A8.978 8.978 0 0 0 12 2.5a8.97 8.97 0 0 0-8.959 8.958A8.97 8.97 0 0 0 12 20.416a8.97 8.97 0 0 0 8.958-8.958c0-2.576-1.09-4.9-3.123-6.76zM12 18.5a7.05 7.05 0 0 1-7.042-7.042A7.05 7.05 0 0 1 12 4.417a7.05 7.05 0 0 1 7.042 7.041A7.05 7.05 0 0 1 12 18.5zm2.875-9.5h-1.916v5.75h1.916V9zm-3.834 0H9.125v5.75h1.916V9z"/></svg></div><div><h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">Upwork</h3><a href={site.upwork} target="_blank" rel="noopener noreferrer" class="text-lg font-medium hover:text-primary transition-colors">{isID ? "Lihat Profil" : "View Profile"}</a></div></Card>
          </div>
        </div>

        <div>
          <Card class="p-8 h-full bg-card/70">
            <h2 class="text-2xl font-bold mb-6">{isID ? "Mulai Inquiry Proyek" : "Start a Project Inquiry"}</h2>
            <p class="text-muted-foreground mb-8">
              {isID
                ? "Untuk versi awal (v1), inquiry dilakukan via email atau form eksternal, jadi tidak ada dependency backend form."
                : "For v1, inquiry is handled via email or external form so there's no backend dependency."}
            </p>
            <div class="space-y-4">
              <Button href={`mailto:${site.email}?subject=Project%20Inquiry%20from%20berutu.dev`} class="w-full">{isID ? "Kirim Email" : "Email Me"}</Button>
              <Button href="https://tally.so" target="_blank" rel="noopener noreferrer" variant="outline" class="w-full">{isID ? "Form Eksternal (Placeholder)" : "External Form (Tally Placeholder)"}</Button>
            </div>
            <div class="mt-8 pt-8 border-t border-border">
              <h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-3">{isID ? "Saran isi inquiry" : "Suggested inquiry details"}</h3>
              <ul class="space-y-2 text-sm text-muted-foreground">
                <li>{isID ? "Nama dan perusahaan/tim" : "Name and company/team"}</li>
                <li>{isID ? "Jenis proyek (MVP, dashboard, API, deployment)" : "Project type (MVP, dashboard, API, deployment)"}</li>
                <li>{isID ? "Estimasi timeline dan budget range" : "Expected timeline and budget range"}</li>
                <li>{isID ? "Ringkasan problem statement" : "Brief problem statement"}</li>
              </ul>
            </div>
          </Card>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
