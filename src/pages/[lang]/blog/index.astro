---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Card from "../../../components/ui/Card.astro";
import Badge from "../../../components/ui/Badge.astro";
import { getCollection } from "astro:content";
import { getReadingTime } from "../../../utils/readingTime";
import { SUPPORTED_LOCALES, type Locale } from "../../../i18n";

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Locale };
const isID = lang === "id";
const posts = await getCollection("blog", ({ data }) => data.draft !== true && data.lang === lang);
const sortedPosts = posts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(isID ? "id-ID" : "en-US", { year: "numeric", month: "long", day: "numeric" }).format(date);
---

<BaseLayout title={isID ? "Blog" : "Blog"} description={isID ? "Artikel teknis dan catatan engineering." : "Technical articles and engineering notes."}>
  <div class="py-24">
    <div class="container mx-auto px-4 max-w-6xl">
      <header class="mb-16">
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Blog</h1>
        <p class="text-xl text-muted-foreground max-w-2xl">
          {isID
            ? "Artikel teknis, catatan engineering, dan breakdown proyek."
            : "Technical articles, engineering notes, and project breakdowns."}
        </p>
      </header>
      {sortedPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedPosts.map((post) => (
            <a href={`/${lang}/blog/${post.id.replace(/^id\//, "").replace(/^en\//, "")}`} class="group">
              <Card class="h-full flex flex-col hover:border-blue-500/50 transition-all duration-300">
                <div class="p-6 flex flex-col h-full">
                  <div class="flex items-center gap-4 mb-4">
                    <Badge variant="outline">{post.data.category}</Badge>
                    <time class="text-xs text-muted-foreground">{formatDate(post.data.publishDate)}</time>
                    <span class="text-xs text-muted-foreground">{getReadingTime(post.body)} {isID ? "mnt baca" : "min read"}</span>
                  </div>
                  <h2 class="text-xl font-bold mb-3 group-hover:text-primary transition-colors">{post.data.title}</h2>
                  <p class="text-muted-foreground text-sm mb-6 flex-grow line-clamp-3">{post.data.description}</p>
                </div>
              </Card>
            </a>
          ))}
        </div>
      ) : (
        <div class="py-20 text-center glass rounded-3xl">
          <p class="text-muted-foreground italic">{isID ? "Artikel baru akan segera hadir." : "New articles coming soon."}</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
