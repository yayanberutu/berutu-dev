---
import { getCollection } from "astro:content";
import BlogSlug from "../../components/pages/blog/[slug].astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => data.draft !== true && data.lang === "en");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/^en\//, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
---
<BlogSlug lang="en" post={post} />
