---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Badge from "../../../components/ui/Badge.astro";
import PraiseButton from "../../../components/blog/PraiseButton";
import { db } from "../../../db";
import { articles, articleTags, users } from "../../../db/schema";
import { eq, and, inArray, desc } from "drizzle-orm";
import { Image } from "astro:assets";
import { site } from "../../../data/site";
import Card from "../../../components/ui/Card.astro";
import ProgressBar from "../../../components/blog/ProgressBar";
import TableOfContents from "../../../components/blog/TableOfContents";
import ShareButtons from "../../../components/blog/ShareButtons";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const user = Astro.locals.user;

// Fetch article from DB
const article = db.select()
  .from(articles)
  .where(and(
    eq(articles.slug, slug),
    user ? undefined : eq(articles.status, "published") // Admin can view drafts
  )).get();

if (!article) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const tags = db.select().from(articleTags).where(eq(articleTags.articleId, article.id)).all().map(t => t.tag);

const formatDate = (dateStr: string | null) => {
  if (!dateStr) return "Draft";
  const date = new Date(dateStr);
  return new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric" }).format(date);
};

const isUpdated = article.updatedAt && article.publishedAt && (new Date(article.updatedAt).getTime() - new Date(article.publishedAt).getTime() > 24 * 60 * 60 * 1000);

const author = db.select().from(users).where(eq(users.id, article.authorId)).get();

const siteUrl = Astro.site || new URL(site.url || 'http://localhost:4321');
const imageUrl = article.coverImageUrl ? new URL(article.coverImageUrl, siteUrl).href : new URL("/brand/icon-on-color.png", siteUrl).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": article.title,
  "description": article.description,
  "image": imageUrl,
  "datePublished": article.publishedAt || article.createdAt,
  "dateModified": article.updatedAt,
  "author": {
    "@type": "Person",
    "name": author?.displayName || "Admin",
    "url": siteUrl.href
  },
  "publisher": {
    "@type": "Organization",
    "name": site.title,
    "logo": {
      "@type": "ImageObject",
      "url": new URL("/brand/icon-on-color.png", siteUrl).href
    }
  }
};

function slugify(text: string) {
  return text.toLowerCase().trim().replace(/[^\w\s-]/g, '').replace(/[\s_-]+/g, '-').replace(/^-+|-+$/g, '');
}

const headings: { id: string, text: string, level: number }[] = [];
const finalHtml = article.contentHtml.replace(/<(h[23])([^>]*)>(.*?)<\/\1>/gi, (match, tag, attrs, innerHtml) => {
  const level = tag.toLowerCase() === 'h2' ? 2 : 3;
  const text = innerHtml.replace(/<[^>]*>?/gm, ''); // strip html tags
  const id = slugify(text) || `heading-${headings.length}`;
  headings.push({ id, text, level });
  // check if id already exists in attrs to prevent double id
  if (attrs.includes('id=')) return match;
  return `<${tag}${attrs} id="${id}">${innerHtml}</${tag}>`;
});

let relatedArticles: any[] = [];
if (tags.length > 0) {
  const relatedTags = db.select().from(articleTags).where(inArray(articleTags.tag, tags)).all();
  const relatedArticleIds = Array.from(new Set(relatedTags.map(t => t.articleId))).filter(id => id !== article.id);
  
  if (relatedArticleIds.length > 0) {
    relatedArticles = db.select()
      .from(articles)
      .where(and(inArray(articles.id, relatedArticleIds), eq(articles.status, "published")))
      .all();
      
    const overlapCounts = relatedTags.reduce((acc, row) => {
      if (row.articleId !== article.id) {
        acc[row.articleId] = (acc[row.articleId] || 0) + 1;
      }
      return acc;
    }, {} as Record<number, number>);
    
    relatedArticles.sort((a, b) => {
      const aOverlap = overlapCounts[a.id] || 0;
      const bOverlap = overlapCounts[b.id] || 0;
      if (aOverlap !== bOverlap) return bOverlap - aOverlap;
      const aDate = new Date(a.publishedAt || a.createdAt).getTime();
      const bDate = new Date(b.publishedAt || b.createdAt).getTime();
      return bDate - aDate;
    });
    
    relatedArticles = relatedArticles.slice(0, 3);
  }
}
---

<BaseLayout 
  title={article.title} 
  description={article.description} 
  image={article.coverImageUrl || undefined} 
  article={true}
  publishedTime={article.publishedAt || article.createdAt}
  authorName={author?.displayName || "Admin"}
>
  <ProgressBar client:load />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="pt-16 pb-28">
    <header class="container mx-auto px-4 max-w-6xl mb-10">
      <div class="flex items-center justify-between mb-8">
        <a href={`/blog`} class="inline-flex items-center text-sm text-muted-foreground hover:text-foreground transition-colors">
          ← Back to Blog
        </a>
        
        {user && (
          <a href={`/admin/articles/${article.id}/edit`} class="inline-flex items-center justify-center px-3 py-1.5 bg-secondary text-secondary-foreground text-xs font-medium rounded hover:bg-secondary/80 transition-colors">
            Edit Article
          </a>
        )}
      </div>

      <div class="flex flex-wrap items-center gap-3 mb-6">
        <Badge variant="outline">{article.category}</Badge>
        <div class="flex flex-col">
          <time class="text-sm text-muted-foreground" datetime={article.publishedAt || article.createdAt}>{formatDate(article.publishedAt)}</time>
          {isUpdated && <span class="text-[11px] text-muted-foreground italic mt-0.5">Updated {formatDate(article.updatedAt)}</span>}
        </div>
        <span class="text-sm text-muted-foreground">{article.readingTimeMinutes} min read</span>
        
        {article.status !== 'published' && (
          <Badge variant="outline" class="bg-amber-500/10 text-amber-500 border-amber-500/20">{article.status.toUpperCase()}</Badge>
        )}
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-5">{article.title}</h1>
      <p class="text-lg text-muted-foreground leading-relaxed max-w-3xl mb-8">{article.description}</p>
      <div class="flex flex-wrap gap-2 mb-10">
        {tags.map((tag) => (
          <a href={`/blog?tag=${tag}`} class="text-xs text-muted-foreground font-mono bg-muted hover:bg-muted/80 transition-colors px-2.5 py-1 rounded-md border border-border">#{tag}</a>
        ))}
      </div>
      {article.coverImageUrl && (
        <div class="aspect-video rounded-2xl overflow-hidden border border-border shadow-lg">
          <Image src={article.coverImageUrl} alt={article.title} width={1200} height={675} class="w-full h-full object-cover" />
        </div>
      )}
    </header>
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="flex flex-col lg:flex-row gap-12">
        <div class="flex-1 min-w-0 max-w-4xl mx-auto w-full">
          <div class="article-content prose prose-blue max-w-none" set:html={finalHtml}></div>
          
          <div class="mt-16 p-6 rounded-2xl glass border border-border flex items-center gap-5">
            {author?.avatarUrl ? (
              <img src={author.avatarUrl} alt={author.displayName} class="w-16 h-16 rounded-full object-cover border border-border shadow-sm" />
            ) : (
              <div class="w-16 h-16 rounded-full bg-primary/20 text-primary flex items-center justify-center text-xl font-bold border border-primary/30 shadow-sm">
                {author?.displayName?.[0] || 'A'}
              </div>
            )}
            <div>
              <div class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-1">Written by</div>
              <a href="/" class="text-lg font-bold hover:text-primary transition-colors">{author?.displayName || "Admin"}</a>
            </div>
          </div>
          
          <div class="mt-8 pt-8 border-t border-border flex flex-col items-center justify-center">
            <div class="mb-8">
              <ShareButtons client:load title={article.title} />
            </div>
            <PraiseButton client:load slug={slug} initialCount={article.praiseCount} />
          </div>

          {relatedArticles.length > 0 && (
            <div class="mt-16 pt-10 border-t border-border">
              <h3 class="text-2xl font-bold mb-8">Related Articles</h3>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {relatedArticles.map((post) => (
                  <a href={`/blog/${post.slug}`} class="group">
                    <Card class="h-full flex flex-col hover:border-blue-500/50 transition-all duration-300">
                      <div class="p-5 flex flex-col h-full">
                        <time class="text-xs text-muted-foreground mb-3">{formatDate(post.publishedAt)}</time>
                        <h4 class="text-lg font-bold mb-3 group-hover:text-primary transition-colors leading-tight">{post.title}</h4>
                        <p class="text-muted-foreground text-sm flex-grow line-clamp-2">{post.description}</p>
                      </div>
                    </Card>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
        
        {headings.length > 0 && (
          <aside class="hidden lg:block w-64 shrink-0">
            <div class="sticky top-24">
              <TableOfContents client:load headings={headings} />
            </div>
          </aside>
        )}
      </div>
    </div>
  </article>
</BaseLayout>
