---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Card from "../../../components/ui/Card.astro";
import Badge from "../../../components/ui/Badge.astro";
import { db } from "../../../db";
import { articles, articleTags } from "../../../db/schema";
import { eq, and, desc, inArray } from "drizzle-orm";

// Get user from locals for conditional rendering
const user = Astro.locals.user;

// Get selected tag from URL if any
const selectedTag = Astro.url.searchParams.get("tag");

// Fetch articles
let query = db.select()
  .from(articles)
  .where(eq(articles.status, "published"))
  .orderBy(desc(articles.publishedAt));

let fetchedArticles = query.all();

// Attach tags efficiently (N+1 fix)
const articleIds = fetchedArticles.map(a => a.id);
const allTagsData = articleIds.length > 0 
  ? db.select().from(articleTags).where(inArray(articleTags.articleId, articleIds)).all()
  : [];
const tagsByArticleId = allTagsData.reduce((acc, row) => {
  if (!acc[row.articleId]) acc[row.articleId] = [];
  acc[row.articleId].push(row.tag);
  return acc;
}, {} as Record<string, string[]>);

const posts = fetchedArticles.map(a => ({
  ...a,
  tags: tagsByArticleId[a.id] || []
}));

const featuredArticleRaw = !selectedTag ? fetchedArticles.find(a => a.featured) : null;
const featuredArticle = featuredArticleRaw ? {
  ...featuredArticleRaw,
  tags: tagsByArticleId[featuredArticleRaw.id] || []
} : null;

// Filter by tag if selected, and exclude featured article if not filtering by tag
const filteredPosts = posts.filter(p => {
  if (selectedTag) return p.tags.includes(selectedTag);
  return p.id !== featuredArticle?.id;
});

// Get all unique tags for the filter bar
const allTags = Array.from(new Set(posts.flatMap(p => p.tags))).sort();

const formatDate = (dateStr: string | null) => {
  if (!dateStr) return "";
  const date = new Date(dateStr);
  return new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric" }).format(date);
};
---

<BaseLayout title="Blog" description="Technical articles and engineering notes.">
  <div class="py-24">
    <div class="container mx-auto px-4 max-w-6xl">
      <header class="mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <h1 class="text-4xl md:text-5xl font-bold mb-6">Blog</h1>
          <p class="text-xl text-muted-foreground max-w-2xl">
            Technical articles, engineering notes, and project breakdowns.
          </p>
        </div>
        {user && (
          <a href="/admin/articles/new" class="inline-flex items-center justify-center px-4 py-2 bg-primary text-primary-foreground font-medium rounded-lg hover:opacity-90 transition-opacity whitespace-nowrap">
            ✍️ Write Article
          </a>
        )}
      </header>

      {/* Tag Filter Bar */}
      {allTags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-10">
          <a 
            href={`/blog`} 
            class={`px-3 py-1.5 text-sm rounded-full transition-colors ${!selectedTag ? 'bg-primary text-primary-foreground font-medium' : 'bg-muted text-muted-foreground hover:bg-muted/80'}`}
          >
            All
          </a>
          {allTags.map(tag => (
            <a 
              href={`/blog?tag=${tag}`} 
              class={`px-3 py-1.5 text-sm rounded-full transition-colors ${selectedTag === tag ? 'bg-primary text-primary-foreground font-medium' : 'bg-muted text-muted-foreground hover:bg-muted/80'}`}
            >
              #{tag}
            </a>
          ))}
        </div>
      )}

      {/* Featured Article */}
      {featuredArticle && (
        <div class="mb-16">
          <a href={`/blog/${featuredArticle.slug}`} class="group block">
            <div class="relative rounded-3xl overflow-hidden glass border border-border group-hover:border-primary/50 transition-all duration-300 h-[400px] md:h-[500px]">
              {featuredArticle.coverImageUrl ? (
                <img src={featuredArticle.coverImageUrl} alt={featuredArticle.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
              ) : (
                <div class="absolute inset-0 bg-gradient-to-br from-primary/20 to-secondary/20"></div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent"></div>
              
              <div class="absolute bottom-0 left-0 right-0 p-8 md:p-12">
                <div class="flex items-center gap-3 mb-4">
                  <Badge variant="default" class="bg-primary text-primary-foreground border-none">Featured</Badge>
                  <Badge variant="outline" class="text-white border-white/30 bg-white/10 backdrop-blur-md">{featuredArticle.category}</Badge>
                  <time class="text-sm text-gray-300">{formatDate(featuredArticle.publishedAt)}</time>
                </div>
                <h2 class="text-3xl md:text-5xl font-bold text-white mb-4 group-hover:text-primary-100 transition-colors leading-tight max-w-4xl">{featuredArticle.title}</h2>
                <p class="text-gray-300 text-lg line-clamp-2 max-w-3xl mb-6">{featuredArticle.description}</p>
                <div class="flex items-center gap-4">
                  <div class="flex gap-2">
                    {featuredArticle.tags.slice(0, 3).map((tag: string) => (
                      <span class="text-xs text-white/80 bg-white/10 backdrop-blur-md px-2 py-1 rounded">#{tag}</span>
                    ))}
                  </div>
                  <div class="flex items-center gap-1.5 text-sm text-white/80 font-medium">
                    <span>👏</span>
                    <span>{featuredArticle.praiseCount}</span>
                  </div>
                </div>
              </div>
            </div>
          </a>
        </div>
      )}

      {filteredPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {filteredPosts.map((post) => (
            <a href={`/blog/${post.slug}`} class="group">
              <Card class="h-full flex flex-col hover:border-blue-500/50 transition-all duration-300">
                <div class="p-6 flex flex-col h-full">
                  <div class="flex items-center flex-wrap gap-3 mb-4">
                    <Badge variant="outline">{post.category}</Badge>
                    <time class="text-xs text-muted-foreground">{formatDate(post.publishedAt)}</time>
                    <span class="text-xs text-muted-foreground">{post.readingTimeMinutes} min read</span>
                  </div>
                  <h2 class="text-xl font-bold mb-3 group-hover:text-primary transition-colors">{post.title}</h2>
                  <p class="text-muted-foreground text-sm mb-4 flex-grow line-clamp-3">{post.description}</p>
                  
                  <div class="flex items-center justify-between mt-auto pt-4 border-t border-border/50">
                    <div class="flex gap-1 overflow-hidden">
                      {post.tags.slice(0, 3).map((tag: string) => (
                        <span class="text-[10px] text-muted-foreground bg-muted/50 px-1.5 py-0.5 rounded truncate">#{tag}</span>
                      ))}
                      {post.tags.length > 3 && <span class="text-[10px] text-muted-foreground">+{post.tags.length - 3}</span>}
                    </div>
                    <div class="flex items-center gap-1.5 text-xs text-muted-foreground font-medium">
                      <span>👏</span>
                      <span>{post.praiseCount}</span>
                    </div>
                  </div>
                </div>
              </Card>
            </a>
          ))}
        </div>
      ) : (
        <div class="py-20 text-center glass rounded-3xl">
          <p class="text-muted-foreground italic">
            {selectedTag 
              ? `No articles found for tag #${selectedTag}.`
              : "New articles coming soon."
            }
          </p>
          {selectedTag && (
            <a href={`/blog`} class="inline-block mt-4 text-sm text-primary hover:underline">
              View all articles
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
